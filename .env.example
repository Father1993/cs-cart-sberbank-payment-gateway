# AS SberPay API — переменные окружения
#
# Этот аддон CS-Cart хранит настройки способа оплаты в БД (админка), а не в .env.
# Файл оставлен для единообразия с open-source практикой и локальных скриптов деплоя.
#
# НИКОГДА не копируйте сюда реальные значения и не коммитьте .env

# Пример: URL магазина для локальных утилит (не используется ядром аддона)
# CSCART_BASE_URL=https://example.com

# Пример: флаг отладки только для вашего окружения разработки
# APP_DEBUG=0
