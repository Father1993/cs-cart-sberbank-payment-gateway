<?xml version="1.0"?>
<addon scheme="3.0" edition_type="VENDOR">
    <id>as_sberpay_api</id>

    <version>1.1.1</version>

    <authors>
        <author>
            <name>Andrej Spinej</name>
            <supplier>Andrej Spinej</supplier>
        </author>
    </authors>
    <supplier>Andrej Spinej</supplier>

    <priority>1000</priority>
    <auto_install>MULTIVENDOR,ULTIMATE</auto_install>
    <status>active</status>
    <default_language>ru</default_language>
    <compatibility>
        <core_edition>
            ULTIMATE,MULTIVENDOR
        </core_edition>
    </compatibility>

    <translations>
        <item for="name" lang="en">AS SberPay API</item>
        <item for="name" lang="ru">AS SberPay API</item>
        <item for="description" lang="en">Payment via Sberbank acquiring (REST API)</item>
        <item for="description" lang="ru">Приём платежей через интернет-эквайринг Сбербанка (REST API)</item>
    </translations>

    <functions>
        <item for="install">fn_as_sberpay_api_install</item>
        <item for="uninstall">fn_as_sberpay_api_uninstall</item>
    </functions>
    <queries>
        <item for="install">
            CREATE TABLE IF NOT EXISTS `?:sberpay_order_meta` (
                `order_id` INT(11) NOT NULL,
                `meta` MEDIUMTEXT NOT NULL,
                `updated_at` INT(11) NOT NULL DEFAULT 0,
                PRIMARY KEY (`order_id`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8
        </item>
        <item for="uninstall">DROP TABLE IF EXISTS `?:sberpay_order_meta`</item>
    </queries>
</addon>